# ---------------------------------------------------------------------------
# gitops-with-argocd — .gitignore
# ---------------------------------------------------------------------------

# --- OS files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Editors / IDEs / tooling ---
.vscode/
.idea/
.claude/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project

# --- Secrets & credentials (NEVER commit these) ---
# Kubeconfigs and cluster access
kubeconfig
kubeconfig.*
*.kubeconfig
.kube/
# Keys / certificates
*.pem
*.key
*.crt
*.p12
*.pfx
id_rsa
id_rsa.*
deploy_key
deploy_key.*
# Environment / secret files
.env
.env.*
*.secret.yaml
*-secret.yaml
secrets.yaml
sealed-secrets.key

# --- Helm ---
# Packaged charts and downloaded dependencies
*.tgz
charts/*.tgz
**/charts/*.tgz
# Local Helm state (keep Chart.lock if you use it — remove the next line to track it)
**/Chart.lock

# --- Kustomize ---
# Locally rendered output (if you `kustomize build > out.yaml`)
rendered.yaml
out.yaml

# --- Logs & temp ---
*.log
*.tmp
*.bak
tmp/
.tmp/

# --- Local overrides (uncomment if you keep private scratch files) ---
# NOTES.local.md
# *.local.yaml
